{
  "name": "tic-tac-toe",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "api": "tsx watch --tsconfig tsconfig.server.json server/index.mts",
    "test:api": "vitest run server/api.integration.spec.mts libs/game/game-service/src/game-service.spec.ts",
    "dev": "concurrently -k \"npm run api\" \"npm run start\"",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src libs server --max-warnings 0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.8",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^27.1.0",
    "prettier": "~3.6.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "packageManager": "npm@11.16.0"
}
